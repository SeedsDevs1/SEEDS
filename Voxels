			if expanded then
				local totalH = (#options * 28) + 42
				frame.Size = UDim2.new(1, 0, 0, totalH)
				listHolder.Size = UDim2.new(1, -20, 0, #options * 28)
			else
				frame.Size = UDim2.new(1, 0, 0, 36)
			end
		end)

		local dropdownObj = {}
		function dropdownObj:Refresh(newOpts)
			options = newOpts or {}
			buildList(options)
			updateTitle()
		end

		function dropdownObj:Set(vals, executeCallback)
			selected = {}
			if type(vals) == "table" then
				for _, v in ipairs(vals) do selected[v] = true end
			elseif type(vals) == "string" then
				selected[vals] = true
			end
			buildList(options)
			updateTitle()
			if executeCallback and c.Callback then
				local res = {}
				for k, v in pairs(selected) do if v then table.insert(res, k) end end
				c.Callback(res)
			end
		end

		function dropdownObj:Get()
			local res = {}
			for k, v in pairs(selected) do if v then table.insert(res, k) end end
			return res
		end

		ConfigRegistry[flag] = {
			Type = "Dropdown",
			Get = function() return dropdownObj:Get() end,
			Set = function(val) dropdownObj:Set(val, true) end
		}

		return dropdownObj
	end

	return obj, pageFrame
end

