    local FallRemote = RS.Systems.CombatSystem.Network.FallDamage
    local DownRemote = RS.Systems.CombatSystem.Network.DrownDamage
    local afdEnabled, adEnabled = false, false
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        if method == "FireServer" then
            if self == FallRemote and afdEnabled then return end
            if self == DownRemote and adEnabled then return end
        end
        return oldNamecall(self, ...)
    end)
    FightTab:CreateToggle({ Name = "No Fall Damage", CurrentValue = false, Callback = function(v) afdEnabled = v end })
    FightTab:CreateToggle({ Name = "No Drown", CurrentValue = false, Callback = function(v) adEnabled = v end })
end

